# Copy to .env.local and fill in locally. Never commit secrets.
# cp .env.example .env.local

# Public URL (recommended for OG links and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared member portal semester password (httpOnly cookie on /portal)
MEMBER_PORTAL_PASSWORD=

# ── Contact form (Resend): add on Vercel for production ───────────────
# Generate an API key in the Resend dashboard. Keep it server-side only.
RESEND_API_KEY=

# Recipient for contact form submissions (defaults to siteConfig.contact.email if unset).
CONTACT_TO_EMAIL=RSO.Limitless@msu.edu

# Verified sender identity in Resend (must match a verified domain/sender in Resend).
# Often: onboarding email for tests, later: noreply@your-production-domain.org
CONTACT_FROM_EMAIL=
